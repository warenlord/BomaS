# --- Supabase ---
# Trouvables dans Project Settings > API sur supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Clé service_role : NE JAMAIS exposer côté client, utilisée uniquement dans les routes serveur
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modele de chat (adapter selon la disponibilite sur ton compte OpenAI)
OPENAI_CHAT_MODEL=gpt-4.1
# Modele d'embeddings pour le RAG documentaire (1536 dimensions)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- SingPay (paiement Mobile Money Airtel/Moov, fintech gabonaise) ---
# Identifiants recuperables sur https://client.singpay.ga (Workspace > API credentials / detail du portefeuille)
SINGPAY_API_BASE_URL=https://gateway.singpay.ga/v1
SINGPAY_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SINGPAY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SINGPAY_WALLET_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# URL publique de l'app, utilisee pour les redirections de paiement et le webhook
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cron (renouvellement mensuel des credits) ---
# Secret partage verifie sur l'en-tete Authorization du endpoint /api/cron/reset-credits
CRON_SECRET=change-moi-en-une-longue-chaine-aleatoire
